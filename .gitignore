# ==========================================
# 白名单规则：只保留自己写的源代码
# ==========================================

*                         # 忽略所有文件
!*/                       # 允许所有目录（让 Git 能进入子文件夹）

# 允许自己写的所有源代码
!*.c
!*.cpp
!*.cc
!*.cxx
!*.h
!*.hpp
!*.hxx
!*.s
!*.S
!*.py
!*.js
!*.ts
!*.vue
!*.sql
!*.sh
!*.bat
!*.ps1
!*.yml
!*.yaml
!*.json
!*.xml
!*.toml
!*.ini
!*.cfg
!*.conf
!*.md
!*.txt

# 允许必要的项目配置文件
!CMakeLists.txt
!*.cmake
!Dockerfile
!*.dockerfile
!docker-compose.yml
!*.proto
!.env.example
!package.json
!package-lock.json
!yarn.lock
!requirements.txt
!pyproject.toml
!.gitignore
!.gitattributes
!.gitmodules

# 允许 STM32CubeMX 的 .ioc 文件（在后面会被更精确的规则限制）
!*.ioc

# ==========================================
# 忽略 IDE 和编辑器
# ==========================================

# Visual Studio 工程文件（保留 .sln 和 .vcxproj 以便打开项目，但忽略用户配置）
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
.vs/
**/.vs/

# VS Code
.vscode/
*.code-workspace

# CLion / JetBrains
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/
**/cmake-build-*/

# Eclipse / STM32CubeIDE
.project
.classpath
.cproject
.settings/
.metadata/
*.launch

# Qt Creator
*.pro.user
*.creator.user
**/.qtc_clangd/

# Vim / Emacs
*.swp
*.swo
*~
\#*#

# ==========================================
# 忽略编译输出
# ==========================================

*.o
*.obj
*.exe
*.out
*.app
*.lib
*.a
*.so
*.dll
*.dylib
*.pdb
*.ilk
*.idb
*.map
*.sym
*.gcno
*.gcda
*.gcov

*.pyc
*.pyo
*.pyd
__pycache__/

*.class

# ==========================================
# 忽略构建目录（所有 IDE 的 Debug/Release）
# ==========================================

**/build/
**/build-*/
**/cmake-build-*/
**/out/build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!*.cmake
!CMakeLists.txt

**/obj/
**/bin/
**/lib/
**/dist/

# ==========================================
# 忽略 Visual Studio 的 Debug/Release 输出目录
# ==========================================

**/Debug/
**/Release/
**/x64/
**/x86/
**/Win32/
**/AnyCPU/
**/out/
**/build/
**/Build/

# 忽略 .tlog 和 .recipe 等 VS 临时文件
**/*.tlog/
**/*.tlog
**/*.recipe
**/*.FileListAbsolute.txt
**/*.lastbuildstate
**/*.Build.CppClean.log

# ==========================================
# 忽略前端 (Vue/Node.js)
# ==========================================

**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

**/dist/
**/dist-ssr/
**/*.local

**/coverage/
**/.nyc_output/

# ==========================================
# 忽略 Python
# ==========================================

.venv/
venv/
env/
**/.venv/
**/venv/

*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.tox/
.coverage
htmlcov/
.mypy_cache/
.ipynb_checkpoints/

# ==========================================
# 忽略数据库
# ==========================================

*.db
*.sqlite
*.ibd
*.frm
*.rdb
*.aof
dump.rdb
*.sql.bak
*.sql.gz

# ==========================================
# 忽略 Qt
# ==========================================

*.moc
moc_*.cpp
ui_*.h
qrc_*.cpp
*.rcc
**/moc/
**/ui/
**/rcc/

# ==========================================
# 忽略 Protobuf 生成代码
# ==========================================

*.pb.cc
*.pb.h
*_pb2.py
*_pb2_grpc.py

# ==========================================
# 忽略操作系统和临时文件
# ==========================================

.DS_Store
Thumbs.db
desktop.ini
*~
*.tmp
*.log
tree.txt
*.tree

# ==========================================
# 忽略环境变量和密钥
# ==========================================

.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
credentials/

# ==========================================
# ★★★ STM32 精确规则（必须放在最后！）★★★
# ==========================================

# 1. 先忽略 stm32 目录下所有 .c 和 .h 文件
stm32/**/*.c
stm32/**/*.h

# 2. 但允许 main.c 和 main.h
!stm32/**/Core/Src/main.c
!stm32/**/Core/Inc/main.h

# 3. 忽略 Drivers 和 MDK-ARM 目录
stm32/**/Drivers/
stm32/**/MDK-ARM/

# 4. 忽略 CubeMX 临时文件
stm32/**/.mxproject
stm32/**/.project
stm32/**/.cproject
stm32/**/.launch
stm32/**/.settings/

# 5. 允许 .ioc 文件
!stm32/**/*.ioc