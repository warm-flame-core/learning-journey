# ============================================================
# 换行符策略：index 内统一 LF，工作区按平台自动转换
# 不强制改写已有文件，只保证今后提交/检出行为一致
# ============================================================
* text=auto

*.c      text
*.h      text
*.cpp    text
*.cc     text
*.cxx    text
*.hpp    text
*.hxx    text
*.py     text
*.sh     text
*.md     text
*.json   text
*.yml    text
*.yaml   text
*.txt    text

# Windows / Visual Studio 工程文件保持 CRLF
*.sln      text eol=crlf
*.vcxproj  text eol=crlf
*.filters  text eol=crlf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# 二进制文件：不做任何换行处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.axf   binary
*.bin   binary
*.hex   binary
*.elf   binary
*.o     binary
*.a     binary
*.lib   binary
