# ---------------------------------------------------------------------------
# 2. Windows 工具生成的工程 / 配置：工作区固定 CRLF
#    这些文件由 Windows 下的 IDE 或 CubeMX 生成、改写，
#    固定 CRLF 可避免工具认为「文件被外部修改」而反复重写。
# ---------------------------------------------------------------------------
*.ioc              text eol=crlf
*.sln              text eol=crlf
*.slnx             text eol=crlf
*.vcxproj          text eol=crlf
*.vcxproj.filters  text eol=crlf
*.filters          text eol=crlf
*.vcproj           text eol=crlf
*.uvprojx          text eol=crlf
*.uvoptx           text eol=crlf
*.uvguix.*         text eol=crlf
*.rc               text eol=crlf
*.res              text eol=crlf
*.bat              text eol=crlf
*.cmd              text eol=crlf
*.ps1              text eol=crlf


